generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  CONCIERGE
  ADMIN
}

enum BookingKind {
  VISIT /// Booked by the hour
  STAY /// Overnight house or pet sitting, booked by the night
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
  DONE
}

model User {
  id          String            @id @default(cuid())
  email       String            @unique
  name        String
  phone       String?
  role        Role              @default(CUSTOMER)
  createdAt   DateTime          @default(now())
  profile     ConciergeProfile?
  bookings    Booking[]
  sessions    Session[]
  loginTokens LoginToken[]
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model LoginToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  redirect  String?
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model ConciergeProfile {
  id               String             @id @default(cuid())
  userId           String             @unique
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  slug             String             @unique
  displayName      String
  headline         String             @default("")
  bio              String             @default("")
  photoUrl         String?
  hourlyRateCents  Int                @default(3500)
  /// Rate for an overnight stay, per night. Null means she doesn't take stays.
  nightlyRateCents Int?
  areas            String[]
  approved         Boolean            @default(false)
  visible          Boolean            @default(true)
  /// Public business line shown on the site instead of brand.phone. Digits only, 10 long.
  businessPhone    String?
  /// Which free service the line is on ("fongo", "textnow" or "other"), for keep-alive tips.
  phoneProvider    String?
  createdAt        DateTime           @default(now())
  services         ConciergeService[]
  availability     Availability[]
  timeOff          TimeOff[]
  bookings         Booking[]
}

model Service {
  id         String             @id @default(cuid())
  slug       String             @unique
  name       String
  sort       Int                @default(0)
  active     Boolean            @default(true)
  concierges ConciergeService[]
  bookings   Booking[]
}

model ConciergeService {
  conciergeId String
  serviceId   String
  concierge   ConciergeProfile @relation(fields: [conciergeId], references: [id], onDelete: Cascade)
  service     Service          @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([conciergeId, serviceId])
}

/// Weekly working hours in the business time zone. Minutes from local midnight.
model Availability {
  id          String           @id @default(cuid())
  conciergeId String
  concierge   ConciergeProfile @relation(fields: [conciergeId], references: [id], onDelete: Cascade)
  weekday     Int /// 0 = Sunday … 6 = Saturday
  startMin    Int
  endMin      Int

  @@index([conciergeId])
}

model TimeOff {
  id          String           @id @default(cuid())
  conciergeId String
  concierge   ConciergeProfile @relation(fields: [conciergeId], references: [id], onDelete: Cascade)
  start       DateTime
  end         DateTime
  note        String?

  @@index([conciergeId, start])
}

model Booking {
  id          String           @id @default(cuid())
  customerId  String
  customer    User             @relation(fields: [customerId], references: [id])
  conciergeId String
  concierge   ConciergeProfile @relation(fields: [conciergeId], references: [id])
  serviceId   String
  service     Service          @relation(fields: [serviceId], references: [id])
  kind        BookingKind      @default(VISIT)
  /// A stay runs from local midnight on the first day to local midnight after the last day.
  start       DateTime
  end         DateTime
  /// Booked hours for a visit; 0 for a stay.
  hours       Int
  /// Nights for a stay; null for a visit.
  nights      Int?
  address     String
  notes       String           @default("")
  priceCents  Int
  status      BookingStatus    @default(CONFIRMED)
  visitNote   String?
  completedAt DateTime?
  cancelledAt DateTime?
  /// When the client's reminder email went out (src/lib/reminders.ts).
  reminderSentAt DateTime?
  createdAt   DateTime         @default(now())

  @@index([conciergeId, start])
  @@index([customerId])
}

/// Who gets the business's own notification emails, set from /admin/notifications.
model NotificationRecipient {
  id        String   @id @default(cuid())
  email     String   @unique
  /// Which notifications this address gets: keys from notifyEvents in src/lib/notify.ts.
  events    String[]
  createdAt DateTime @default(now())
}
