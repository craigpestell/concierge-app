generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  CONCIERGE
  ADMIN
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
  DONE
}

model User {
  id          String            @id @default(cuid())
  email       String            @unique
  name        String
  phone       String?
  role        Role              @default(CUSTOMER)
  createdAt   DateTime          @default(now())
  profile     ConciergeProfile?
  bookings    Booking[]
  sessions    Session[]
  loginTokens LoginToken[]
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model LoginToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  redirect  String?
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model ConciergeProfile {
  id              String             @id @default(cuid())
  userId          String             @unique
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  slug            String             @unique
  displayName     String
  headline        String             @default("")
  bio             String             @default("")
  photoUrl        String?
  hourlyRateCents Int                @default(3500)
  areas           String[]
  approved        Boolean            @default(false)
  visible         Boolean            @default(true)
  createdAt       DateTime           @default(now())
  services        ConciergeService[]
  availability    Availability[]
  timeOff         TimeOff[]
  bookings        Booking[]
}

model Service {
  id         String             @id @default(cuid())
  slug       String             @unique
  name       String
  sort       Int                @default(0)
  active     Boolean            @default(true)
  concierges ConciergeService[]
  bookings   Booking[]
}

model ConciergeService {
  conciergeId String
  serviceId   String
  concierge   ConciergeProfile @relation(fields: [conciergeId], references: [id], onDelete: Cascade)
  service     Service          @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([conciergeId, serviceId])
}

/// Weekly working hours in the business time zone. Minutes from local midnight.
model Availability {
  id          String           @id @default(cuid())
  conciergeId String
  concierge   ConciergeProfile @relation(fields: [conciergeId], references: [id], onDelete: Cascade)
  weekday     Int /// 0 = Sunday … 6 = Saturday
  startMin    Int
  endMin      Int

  @@index([conciergeId])
}

model TimeOff {
  id          String           @id @default(cuid())
  conciergeId String
  concierge   ConciergeProfile @relation(fields: [conciergeId], references: [id], onDelete: Cascade)
  start       DateTime
  end         DateTime
  note        String?

  @@index([conciergeId, start])
}

model Booking {
  id          String           @id @default(cuid())
  customerId  String
  customer    User             @relation(fields: [customerId], references: [id])
  conciergeId String
  concierge   ConciergeProfile @relation(fields: [conciergeId], references: [id])
  serviceId   String
  service     Service          @relation(fields: [serviceId], references: [id])
  start       DateTime
  end         DateTime
  hours       Int
  address     String
  notes       String           @default("")
  priceCents  Int
  status      BookingStatus    @default(CONFIRMED)
  visitNote   String?
  completedAt DateTime?
  cancelledAt DateTime?
  createdAt   DateTime         @default(now())

  @@index([conciergeId, start])
  @@index([customerId])
}
