# Postgres connection string. On DigitalOcean this comes from the managed database.
DATABASE_URL="postgresql://postgres@localhost:5432/concierge"

# Public URL of the site, used in emailed sign-in links.
APP_URL="http://localhost:3000"

# Comma-separated emails that get admin access when they sign in.
ADMIN_EMAILS="admin@example.com"

# Email delivery through Resend. Leave empty in development to print emails to the console.
RESEND_API_KEY=""
EMAIL_FROM="Royal City Concierge <hello@example.com>"
