# Copy to .env on the server and fill in. Never commit the real file.

# Long random password for the database, e.g. from: openssl rand -hex 24
POSTGRES_PASSWORD=

# Public address of the site, used in emailed sign-in links.
APP_URL=http://YOUR_DROPLET_IP

# ":80" serves plain HTTP on the droplet's IP. Once DNS points here, set it to the
# domain, e.g. "royalcityconcierge.com, www.royalcityconcierge.com", and update APP_URL.
SITE_ADDRESS=:80

# Comma-separated emails that get the admin page when they sign in.
ADMIN_EMAILS=

# Email delivery through Resend. Empty means sign-in links only appear in: docker compose logs app
RESEND_API_KEY=
EMAIL_FROM=Royal City Concierge <hello@royalcityconcierge.com>

# Days of nightly database backups to keep in ./backups.
BACKUP_KEEP_DAYS=14
