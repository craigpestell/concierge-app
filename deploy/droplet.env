# Settings for deploy/create-droplet.sh. Change these to reuse the script for another site.
DROPLET_NAME=concierge
REGION=tor1                    # Toronto
SIZE=s-1vcpu-1gb               # Basic, 1 GB RAM, 1 CPU, 25 GB disk (about US$6/month)
IMAGE=ubuntu-24-04-x64
TAG=concierge                  # The cloud firewall applies to droplets with this tag
FIREWALL_NAME=concierge-web
ENABLE_BACKUPS=false           # true adds weekly DigitalOcean backups (+20% of the droplet price)
SSH_KEY_NAME=concierge-deploy
SSH_KEY_FILE=$HOME/.ssh/concierge_deploy
GITHUB_REPO=craigpestell/concierge-app
